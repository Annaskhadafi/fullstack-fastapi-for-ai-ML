# ==============================================================================
# APP CONFIGURATION
# ==============================================================================
APP_NAME="Afi Template"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# ==============================================================================
# DATABASE CONFIGURATION (POSTGRESQL / NEON DB)
# ==============================================================================
# Format Neon DB PostgreSQL (Serverless Pooled recommended for production):
# DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-sample-12345-pooler.us-east-2.aws.neon.tech/neondb?ssl=require
#
# Catatan: Jika DATABASE_URL dikosongkan, boilerplate akan otomatis fallback ke SQLite async (local.db)
# agar bisa langsung diuji coba secara instan di local tanpa koneksi internet/DB.
DATABASE_URL=

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
# Jalankan `openssl rand -hex 32` di terminal untuk generate SECRET_KEY baru
SECRET_KEY=replace-with-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=False  # Ubah ke True di production HTTPS
# Public origin shown in dashboard API examples. Leave empty to use the request origin.
PUBLIC_BASE_URL=

# ==============================================================================
# AI PROVIDERS & OPENAI SDK COMPATIBILITY
# ==============================================================================
# Dapatkan Gemini API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI SDK Compatible: Mendukung OpenAI, Groq, DeepSeek, Cloudflare Workers AI, Ollama
OPENAI_API_KEY=
# OPENAI_BASE_URL:
# - OpenAI default: https://api.openai.com/v1 (kosongkan untuk default)
# - Groq: https://api.groq.com/openai/v1
# - DeepSeek: https://api.deepseek.com/v1
# - Cloudflare Workers AI: https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# - Ollama Local: http://localhost:11434/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==============================================================================
# S3 & CLOUDFLARE R2 OBJECT STORAGE (COMPATIBLE)
# ==============================================================================
# Jika dikosongkan, file upload otomatis disimpan di folder lokal (app/static/uploads/)
#
# Untuk Cloudflare R2:
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_r2_access_key
# S3_SECRET_ACCESS_KEY=your_r2_secret_key
# S3_BUCKET_NAME=your_r2_bucket_name
# S3_REGION_NAME=auto
# S3_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev
#
# Untuk AWS S3 / MinIO:
# S3_ENDPOINT_URL=https://s3.amazonaws.com (atau http://localhost:9000 untuk MinIO)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=fastapi-ai-uploads
S3_REGION_NAME=auto
S3_PUBLIC_DOMAIN=

# ==============================================================================
# COMPUTER VISION & MACHINE LEARNING
# ==============================================================================
CV_MODEL_NAME=yolov8n.onnx
CV_CONFIDENCE_THRESHOLD=0.35
